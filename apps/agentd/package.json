{
  "name": "@rakazo/agentd",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Headless host agent: runs on a machine in the background, connects outbound to a Rakazo server, and executes the bot commands that server sends.",
  "bin": {
    "rakazo-agentd": "./dist/agentd.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/agentd.mjs run",
    "package": "node build.mjs && node package.mjs"
  },
  "dependencies": {
    "@rakazo/adapters": "workspace:*",
    "@rakazo/contracts": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
